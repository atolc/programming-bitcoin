{
  "name": "programming-bitcoin-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://atolc.github.io/programming-bitcoin/",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "split-sections": "node scripts/split-sections.mjs",
    "generate:manifest": "node scripts/generate-manifest.mjs",
    "generate:exercises": "node scripts/generate-exercises.mjs",
    "bootstrap:en": "node scripts/bootstrap-en-docs.mjs",
    "build": "node scripts/validate-math.mjs && node scripts/validate-locales.mjs && node scripts/validate-chapters.mjs && node scripts/validate-exercises.mjs && tsc -b && vite build && node scripts/copy-static.mjs",
    "normalize:math": "node scripts/normalize-math.mjs",
    "validate:math": "node scripts/validate-math.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "validate:chapters": "node scripts/validate-chapters.mjs",
    "validate:exercises": "node scripts/validate-exercises.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && gh-pages -d dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "i18next": "^26.3.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "pyodide": "^0.29.4",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.5.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.15",
    "postcss-nesting": "^14.0.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
